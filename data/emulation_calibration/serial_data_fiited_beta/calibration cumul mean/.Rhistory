#matplot(okfd.res$krig.new.data,type="l", ylim=c(0,10),add=T, col="grey", lty=2)
lines(okfd.res$krig.new.data, col=2, lwd=2)
lines(t(obs),lwd=2,col=3)
}
## Cumulative summation
cumsum(okfd.res$krig.new.data); cumsum(obs)
cumsum(obs)
